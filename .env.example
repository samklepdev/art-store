# Postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/art_store
# Set to "require" for hosted Postgres (Neon, Supabase, RDS, etc.)
PGSSL=

# Public URL of the site (used for Stripe redirects and product images)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_PROD_SITE_URL=https://samklepper.shop

# Stripe: dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
# From `npm run stripe:listen` locally, or the webhook endpoint in the Stripe dashboard
STRIPE_WEBHOOK_SECRET=whsec_...

# Admin (/admin). Generate the secret with: openssl rand -base64 32
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Image storage. Works with any S3-compatible bucket (AWS S3, Cloudflare R2,
# Backblaze B2, MinIO). Leave S3_ENDPOINT blank for AWS.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL the bucket serves from, e.g. https://images.example.com
S3_PUBLIC_BASE_URL=
# MinIO and some self-hosted gateways need path-style addressing
S3_FORCE_PATH_STYLE=false
